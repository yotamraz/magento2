<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="StorefrontProductPageLoadsWithTagModuleTest">
        <annotations>
            <features value="Tag"/>
            <stories value="Product Page Tag Display"/>
            <title value="Product page loads without errors when Magento_Tag module is enabled"/>
            <description value="A product detail page should load successfully after enabling the Magento_Tag module. The tags block is not rendered for products with no approved tags (template guards with count check)."/>
            <severity value="CRITICAL"/>
            <group value="tag"/>
            <group value="pr_exclude"/>
        </annotations>
        <before>
            <createData entity="SimpleProduct2" createDataKey="product" stepKey="createProduct"/>
        </before>
        <after>
            <deleteData createDataKey="product" stepKey="deleteProduct"/>
        </after>
        <amOnPage url="$product.custom_attributes[url_key]$.html" stepKey="navigateToProduct"/>
        <waitForPageLoad stepKey="waitForProductPage"/>
        <seeElement selector=".product-info-main" stepKey="seeProductInfo"/>
        <dontSeeElement selector=".product-tags" stepKey="confirmNoTagsForProductWithoutTags"/>
    </test>
</tests>
