{
    "name": "magento/module-tag",
    "description": "Magento Tag module — ports Mage_Tag product-tagging feature to Magento 2",
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": "~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": "*",
        "magento/module-backend": "*",
        "magento/module-catalog": "*",
        "magento/module-customer": "*",
        "magento/module-eav": "*",
        "magento/module-reports": "*",
        "magento/module-store": "*",
        "magento/module-ui": "*"
    },
    "type": "magento2-module",
    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Magento\\Tag\\": ""
        }
    }
}
